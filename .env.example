# ── AI Video Assistant Environment Configuration ──
# 100% Local & Privacy-First Architecture (Zero Cloud APIs)

# Local Ollama URL (Default: http://localhost:11434/v1)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Local LLM Model (Default: qwen3:8b)
# Pull with: ollama pull qwen3:8b
OLLAMA_MODEL=qwen3:8b

# Local Whisper Speech-to-Text Model (tiny, base, small, medium, large)
# Larger models are more accurate but slower. "small" is recommended for CPU.
WHISPER_MODEL=small

# Local Multilingual Embedding Model (used by FAISS RAG pipeline)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── Vision / Visual Analysis (Optional) ──────────────────────────────────────
# Local Ollama vision model for video frame analysis.
# Pull with: ollama pull qwen2.5vl:3b   (smaller) or: ollama pull llava:7b
# Leave as-is or set to any Ollama vision-capable model you have installed.
# If the model is not available, visual analysis is silently skipped.
VISION_MODEL=qwen2.5vl:3b

# Maximum number of video frames to sample and analyze per recording.
MAX_VISION_FRAMES=20

# Ollama inference timeout in seconds (default: 300 = 5 minutes).
# Increase if your machine is slow or you are using large models.
OLLAMA_TIMEOUT=300
